# Unified Vercel deploy (root vercel.json): leave empty — API is same origin at /api
VITE_API_URL=

# Split deploy (frontend-only project): set to your backend URL + /api
# VITE_API_URL=https://your-backend.vercel.app/api

# WebSocket base (optional). Defaults to wss://<host>/api on production.
# VITE_WS_URL=
