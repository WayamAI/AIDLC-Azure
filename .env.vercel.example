# Vercel environment variables
# Copy these into your Vercel project → Settings → Environment Variables
# NEVER put real secrets in this file placeholders only.

# ── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aidlc

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-key
OLLAMA_MODEL=gpt-oss:120b

# ── Auth (WorkOS AuthKit) ───────────────────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
SESSION_SECRET=generate-a-long-random-string
FRONTEND_URL=https://your-app.vercel.app

# ── CORS (split deploy only unified deploy uses same origin) ───────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# ── Optional integrations ───────────────────────────────────────────────────
GITHUB_TOKEN=
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
SLACK_WEBHOOK_URL=
DATADOG_API_KEY=
DATADOG_APP_KEY=

APP_ENV=production
