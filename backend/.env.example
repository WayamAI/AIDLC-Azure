# ── MongoDB ────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aidlc

# ── Ollama (used by app/services/ai_service.py, app/engines/generator.py) ──
# Local Ollama:  OLLAMA_BASE_URL=http://localhost:11434, any non-empty OLLAMA_API_KEY.
# Ollama cloud (pro): OLLAMA_BASE_URL=https://ollama.com and an API key from
# https://ollama.com/settings/keys, with a cloud model e.g. gpt-oss:120b.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1

# ── GitHub / Vercel Deployment ─────────────────────────────────────────────
# Repo numeric ID: curl https://api.github.com/repos/<owner>/<repo> | jq .id
GITHUB_TOKEN=
GITHUB_REPO_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# ── Jira ───────────────────────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Datadog ────────────────────────────────────────────────────────────────
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated allowed origins (used for CORS)
# Pydantic-settings will parse this as a JSON list. Production previews on
# Vercel, Cloudflare Pages, and Cloudflare Tunnel are handled by a regex in main.py.
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:8083"]
