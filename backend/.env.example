# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aidlc

# ── Ollama ─────────────────────────────────────────────────────────────────
# Local: http://localhost:11434 and any non-empty OLLAMA_API_KEY (e.g. ollama)
# Cloud: https://ollama.com + real key from https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=paste-your-real-ollama-cloud-key-here
OLLAMA_MODEL=kimi-k3:cloud

# ── GitHub / Vercel ────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# ── Jira / Slack / Datadog ─────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=
SLACK_WEBHOOK_URL=
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:8083"]

# ── WorkOS AuthKit ─────────────────────────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
SESSION_SECRET=change-me-in-production
